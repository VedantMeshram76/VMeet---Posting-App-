<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
        <title>Vmeet - Post</title>
        <!-- Google Fonts for the clean look -->
        <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
            rel="stylesheet">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <%- include("partials/nav") %>

        <style>
            body {
                background: radial-gradient(circle at top right, #fdfcfd, #f3e8ff 40%, #e9d5ff 100%);
                background-attachment: fixed;
                font-family: 'Plus Jakarta Sans', sans-serif;
                min-height: 100vh;
            }

            .feed-container {
                max-width: 520px;
                margin: 0 auto;
                padding-top: 40px;
            }

            /* --- The Glass Card --- */
            .glass-card {
                background: rgba(255, 255, 255, 0.7);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.6);
                border-radius: 28px;
                padding: 24px;
                box-shadow: 0 10px 40px rgba(168, 85, 247, 0.06);
                margin-bottom: 30px;
            }

            /* --- User Header Styling (Fixes the "?" alignment) --- */
            .profile-section {
                display: flex;
                align-items: center;
                margin-bottom: 18px;
            }

            .avatar-container {
                position: relative;
                padding: 3px;
                background: linear-gradient(135deg, #a855f7, #d8b4fe);
                border-radius: 18px;
                margin-right: 14px;
            }

            .avatar-box {
                width: 44px;
                height: 44px;
                background: white;
                border-radius: 15px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                color: #9333ea;
            }

            .username {
                font-weight: 700;
                color: #1f2937;
                font-size: 1rem;
                display: block;
                line-height: 1.2;
            }

            .post-time {
                font-size: 0.75rem;
                color: #9ca3af;
                font-weight: 500;
            }

            /* --- Rest of the styles --- */
            .post-content {
                font-size: 1.05rem;
                color: #374151;
                line-height: 1.6;
                margin-bottom: 16px;
            }

            .media-container {
                border-radius: 22px;
                overflow: hidden;
                margin-bottom: 16px;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
            }

            .post-img {
                width: 100%;
                display: block;
            }

            .action-row {
                display: flex;
                gap: 12px;
                margin-top: 15px;
                padding-bottom: 15px;
                border-bottom: 1px solid rgba(168, 85, 247, 0.1);
            }

            .btn-pill {
                background: rgba(168, 85, 247, 0.05);
                padding: 8px 16px;
                border-radius: 50px;
                color: #6b7280;
                font-size: 0.85rem;
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none !important;
            }

            .comment-input-area {
                margin-top: 15px;
                background: #fff;
                border-radius: 20px;
                padding: 10px 20px;
                display: flex;
                align-items: center;
                border: 1px solid rgba(168, 85, 247, 0.15);
            }

            .comment-input-area input {
                border: none;
                width: 100%;
                outline: none;
                font-size: 0.9rem;
            }

            .text-purple {
                color: #9d7cfd !important;
            }
        </style>

        <div class="feed-container">
            <% if (currentPost  && postUser) { %>
                <div class="glass-card">
                    <!-- Header -->
                    <div class="profile-section">
                        <div class="avatar-container">
                            <div class="avatar-box">
                                <%= postUser?.fullName ? postUser.fullName.charAt(0).toUpperCase() : '?' %>
                            </div>
                        </div>
                        <div>
                            <span class="username">
                                <%= postUser?.fullName %>
                            </span>
                            <span class="post-time">
                                Posted at <span style="color: #a855f7;">
                                    <%= new Date(currentPost.createdAt).toLocaleTimeString() %>
                                </span>
                            </span>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="post-content">
                        <%= currentPost.content %>
                    </div>

                    <!-- Media -->
                    <% if (currentPost.post) { %>
                        <div class="media-container">
                            <img src="<%= currentPost.post %>" class="post-img" alt="Content">
                        </div>
                        <% } %>

                            <!-- Buttons -->
                            <div class="action-row">
                                <a href="#" class="btn-pill">
                                    <i class="fa-regular fa-heart"></i>
                                    <span>
                                        <%= currentPost.likes %>
                                    </span>
                                </a>

                            </div>


                            <!-- Visible Comments Area -->
                            <div class="mt-4">
                                <h6 class="fw-bold mb-3" style="font-size: 0.9rem; color: #6b7280;">Comments <%= comments.length %></h6>

                                <% if (comments && comments.length> 0) { %>
                                    <% comments.forEach(comment=> { %>
                                        <div class="d-flex mb-3">
                                            <!-- Commenter Avatar (Mini) -->
                                            <div class="me-2">
                                                <div
                                                    style="width: 32px; height: 32px; background: #f3e8ff; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700; color: #9333ea; border: 1px solid #e9d5ff;">
                                                    <%= comment.user?.fullName ?
                                                        comment.user.fullName.charAt(0).toUpperCase() : '?' %>
                                                </div>
                                            </div>

                                            <!-- Comment Bubble -->
                                            <div class="p-3 flex-grow-1"
                                                style="background: rgba(168, 85, 247, 0.04); border-radius: 0 18px 18px 18px; border: 1px solid rgba(168, 85, 247, 0.08);">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="fw-bold" style="font-size: 0.85rem; color: #1f2937;">
                                                        <%= comment.user?.fullName %>
                                                    </span>
                                                    <span style="font-size: 0.7rem; color: #9ca3af;">
                                                        <%= new Date(comment.createdAt).toLocaleDateString() %>
                                                    </span>
                                                </div>
                                                <p class="mb-0"
                                                    style="font-size: 0.9rem; color: #4b5563; line-height: 1.4;">
                                                    <%= comment.content %>
                                                </p>
                                            </div>
                                        </div>
                                        <% }) %>
                                            <% } else { %>
                                                <p class="text-center text-muted my-4"
                                                    style="font-size: 0.85rem; font-style: italic;">
                                                    No comments yet. Start the conversation!
                                                </p>
                                                <% } %>
                            </div>

                            <!-- Quick Comment Input Form (Placed after the list) -->
                            <form action="/users/comment/<%= currentPost._id %>" method="POST" class="mt-3">
                                <div class="comment-input-area">
                                    <input type="text" name="content" placeholder="Write a kind comment..." required>
                                    <button type="submit" class="btn text-purple">
                                        <i class="fa-solid fa-paper-plane"></i>
                                    </button>
                                </div>
                            </form>


                </div>
                <% } %>
                
        </div>

        <%- include("partials/script") %>
</body>

</html>