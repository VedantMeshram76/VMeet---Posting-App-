<!DOCTYPE html>
<html lang="en">

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Post</title>
</head>

<body>
  

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

      <%- include("partials/nav") %>
    
    <div class="container mt-5">
        <div class="card shadow-sm border-0" style="max-width: 500px; margin: auto;">
            <div class="card-header bg-primary bg-gradient text-white p-3"
                style="background-color: #e1d5f5 !important; color: #5a2d91 !important; border-bottom: 2px solid #d1b3ff;">
                <h5 class="mb-0 fw-bold">✨ Create a New Post</h5>
            </div>

            <div class="card-body p-4" style="background-color: #f8f5ff;">
                <form action="/users/post" method="POST" enctype="multipart/form-data">


                    <!-- Post Content -->
                    <div class="mb-3">
                        <label for="postContent" class="form-label fw-semibold text-dark">Content</label>
                        <textarea class="form-control border-purple shadow-sm" id="postContent" name="content" rows="4"
                            placeholder="Share your thoughts with the Vmeet community..."
                            style="border-color: #d1b3ff;"></textarea>
                        <div id="postHelp" class="form-text text-muted">Keep it friendly and engaging!</div>
                    </div>

                    <div class="mb-3">
                        <label for="postMedia" class="form-label fw-semibold text-dark">Add to your post</label>
                        <div class="input-group">
                            <!-- Hidden actual input -->
                            <input type="file" class="form-control d-none" name="post" id="postMedia">

                            <!-- Styled Trigger Label -->
                            <label
                                class="form-control d-flex align-items-center justify-content-center border-dashed p-4 shadow-sm"
                                for="postMedia"
                                style="border: 2px dashed #d1b3ff; background-color: #ffffff; cursor: pointer; border-radius: 10px; transition: 0.3s;">
                                <div class="text-center">
                                    <span class="fs-3">📸</span>
                                    <p class="mb-0 text-muted small">Upload photos or videos</p>
                                </div>
                            </label>
                        </div>
                    </div>
                    <!-- Action Button -->
                    <div class="d-grid">
                        <button type="submit" class="btn btn-lg text-white shadow"
                            style="background: linear-gradient(45deg, #9b6dff, #cc99ff); border: none;">
                            Post to Vmeet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


</body>

</html>